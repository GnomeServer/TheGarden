# Ansible-generated files
*.retry
.ansible/
collections/

# Local audit output. These files can contain hostnames, IP addresses,
# package inventories, service names, and other machine-specific details.
**/state/*-facts.json
**/state/*-packages.json
**/state/*-services.json
**/state/tailscale-status.txt
**/state/proxmox-version.txt
**/state/*.log

# Local secrets
.secrets/
**/state/audit-meta.yml
