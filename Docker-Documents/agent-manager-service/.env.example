# Keep this file private after copying it to .env.

# Pin images deliberately during upgrades.
POSTGRES_IMAGE=postgres:16-alpine
NATS_IMAGE=nats:2.11-alpine
NATS_EXPORTER_IMAGE=natsio/prometheus-nats-exporter:0.20.2
AGENT_MANAGER_IMAGE=local/agent-manager:dev

POSTGRES_DB=agent_manager
POSTGRES_USER=agent_manager
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Bootstrap machine/API access. Use Forgejo OAuth for normal human sessions.
AGENT_MANAGER_API_TOKEN=replace-with-a-long-random-api-token

# Separate run-only credential for the server-side Open WebUI Pipe.
# The central deployment helper creates this if absent; never reuse the admin token.
AGENT_MANAGER_OPENWEBUI_TOKEN=

# Dashboard URL, signed sessions, and initial Forgejo administrators.
DASHBOARD_PUBLIC_URL=https://infra-lab-services.tail494f6d.ts.net
DASHBOARD_SESSION_SECRET=replace-with-an-independent-long-random-session-secret
DASHBOARD_SESSION_SECURE=true
DASHBOARD_ADMINS=your-forgejo-login
WORKER_OFFLINE_AFTER_SECONDS=45

# Create an OAuth2 application in Forgejo with callback:
# https://infra-lab-services.tail494f6d.ts.net/auth/forgejo/callback
FORGEJO_PUBLIC_URL=https://infra-lab-services.tail494f6d.ts.net/forgejo
FORGEJO_OAUTH_CLIENT_ID=
FORGEJO_OAUTH_CLIENT_SECRET=

# Configure Forgejo webhooks for /v1/webhooks/forgejo with this secret.
FORGEJO_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Prometheus summaries appear in the Nodes view. Notifications are optional;
# the webhook receives one deduplicated event at 24h, 2h, and overdue.
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_TIMEOUT=5
GRAFANA_PUBLIC_URL=https://infra-lab-services.tail494f6d.ts.net/grafana
GRAFANA_NODE_DASHBOARD_UID=server-overview
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
NOTIFICATION_SCAN_SECONDS=60

# The API is loopback-only on the VM by default.
AGENT_MANAGER_BIND_ADDRESS=127.0.0.1
AGENT_MANAGER_PORT=8090

# Internal service endpoints. These names resolve on the shared Docker networks.
FORGEJO_API_URL=http://forgejo:3000/api/v1
FORGEJO_TOKEN=
MODEL_BASE_URL=http://litellm:4000/v1
MODEL_API_KEY=
LOG_LEVEL=INFO
