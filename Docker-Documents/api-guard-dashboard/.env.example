# This is a separate service with a separate Forgejo OAuth application and admin allowlist.
API_GUARD_PUBLIC_URL=https://infra-lab-services.tail494f6d.ts.net
API_GUARD_SESSION_SECRET=replace-with-a-long-random-independent-session-secret
API_GUARD_SESSION_SECURE=true
API_GUARD_ADMINS=bgurrol4
API_GUARD_FORGEJO_PUBLIC_URL=https://infra-lab-services.tail494f6d.ts.net/forgejo
API_GUARD_FORGEJO_API_URL=http://forgejo:3000/api/v1
API_GUARD_FORGEJO_CLIENT_ID=
API_GUARD_FORGEJO_CLIENT_SECRET=

# Keybroker performs all LiteLLM key and spend administration. API Guard uses
# only this separate dashboard token; the LiteLLM master key belongs to Keybroker.
API_GUARD_KEYBROKER_BASE_URL=http://keybroker:8000
KEYBROKER_DASHBOARD_TOKEN=
# Used only for the optional JEV model request with its dedicated restricted virtual key.
API_GUARD_LITELLM_BASE_URL=http://litellm:4000
# Optional OpenAI organization Costs API access. This is NOT the project API key
# used for inference. Use an organization Admin API key with Usage Read access.
API_GUARD_OPENAI_ADMIN_API_KEY=
# Set to the OpenAI project used by LiteLLM to exclude other org projects.
API_GUARD_OPENAI_PROJECT_ID=

# Shared HMAC secret with OMP and Keybroker exposure-event reporters.
API_GUARD_EXPOSURE_WEBHOOK_SECRET=
# Agent Manager Forge incident inbox and signed readiness endpoint.
# Set the two shared random secrets below in both API Guard and Agent Manager.
API_GUARD_ALERT_WEBHOOK_URL=http://agent-manager:8000/v1/webhooks/api-guard/exposure
API_GUARD_ALERT_STATUS_URL=http://agent-manager:8000/v1/webhooks/api-guard/status
# Use a distinct random secret; never reuse the inbound exposure secret.
API_GUARD_ALERT_WEBHOOK_SECRET=
# Shared with Agent Manager to report human acknowledgment back to API Guard.
API_GUARD_ALERT_ACK_SECRET=

# $25,000 annual ceiling. Monthly pacing target is computed as annual / 12.
API_GUARD_ANNUAL_BUDGET_USD=25000
# Rotate every 14 days by default; set 7 for a weekly warning/rotation cadence.
API_GUARD_ROTATION_DAYS=14

# Optional JEV advisor: use a dedicated LiteLLM virtual key restricted to the jev model.
# JEV only receives sanitized aggregates and never authorizes key actions.
API_GUARD_JEV_MODEL=jev
API_GUARD_JEV_API_KEY=
