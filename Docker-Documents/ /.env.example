# Keep this file private after copying it to .env.

# Pin images deliberately during upgrades.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.103.0
POSTGRES_IMAGE=postgres:16-alpine

POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Both values are required for LiteLLM proxy authentication and encrypted
# provider credentials. LITELLM_SALT_KEY cannot be changed after keys/models
# have been stored in the database.
LITELLM_MASTER_KEY=sk-replace-with-a-long-random-master-key
LITELLM_SALT_KEY=replace-with-a-long-random-salt-key

# The host port is loopback-only. Remote workers use the Caddy/Tailscale URL.
LITELLM_BIND_ADDRESS=127.0.0.1
LITELLM_PORT=4000

# The gateway's stable public model name is "luna".
# For the current local llama.cpp container, the single-model server accepts
# the alias sent by LiteLLM. For a backend that validates model IDs, set this
# to its full provider/model value, for example:
# LUNA_MODEL=openai//models/gemma-3-4b-it-Q4_K_M.gguf
LUNA_API_BASE=http://llama:8080/v1
LUNA_MODEL=openai/luna
LUNA_BACKEND_API_KEY=replace-with-the-worker-inference-api-key
