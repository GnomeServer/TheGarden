# Copy this file to .env and set a unique strong password before starting.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-this-with-a-long-random-password

# Image tags are pinned by default. Change them deliberately during upgrades.
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.1.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
