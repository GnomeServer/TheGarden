# Copy to .env, set unique secrets, and keep .env out of Git.
CADDY_NETWORK=caddy_proxy

# Forgejo application URL. This is also the VM's Tailscale MagicDNS name.
FORGEJO_DOMAIN=infra-lab-services.tail494f6d.ts.net

# SSH clone access is exposed only on the VM's Tailscale address.
FORGEJO_TAILSCALE_IP=100.94.49.45
FORGEJO_SSH_PORT=2222

# Pin images deliberately during upgrades.
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:16.0.5
POSTGRES_IMAGE=postgres:16-alpine

FORGEJO_UID=1000
FORGEJO_GID=1000

POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Leave registration enabled for the first setup so the initial admin can be created.
# Set both values to true after creating the administrator account if this remains private.
FORGEJO_DISABLE_REGISTRATION=false
FORGEJO_REQUIRE_SIGNIN_VIEW=false
FORGEJO_DEFAULT_PRIVATE=true
FORGEJO_PACKAGES_ENABLED=true
FORGEJO_ACTIONS_ENABLED=true
