# Set unique random values locally; never commit the populated .env.
POSTGRES_DB=keybroker
POSTGRES_USER=keybroker
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# This is the only new service (besides LiteLLM itself) given the LiteLLM master key.
KEYBROKER_LITELLM_MASTER_KEY=replace-with-the-LiteLLM-master-key
KEYBROKER_LITELLM_BASE_URL=http://litellm:4000

# API Guard calls admin routes through Docker networking.
KEYBROKER_DASHBOARD_TOKEN=replace-with-a-distinct-long-random-token

# Caddy injects this token and the actual remote Tailnet address on the worker route.
KEYBROKER_PROXY_TOKEN=replace-with-a-distinct-long-random-token

# Must match API_GUARD_EXPOSURE_WEBHOOK_SECRET in the API Guard deployment.
KEYBROKER_EXPOSURE_WEBHOOK_SECRET=replace-with-the-shared-exposure-webhook-secret
KEYBROKER_EXPOSURE_WEBHOOK_URL=http://api-guard:8000/api-guard/api/v1/webhooks/exposure

# Session policy is enforced server-side; mission input cannot override these values.
KEYBROKER_DEFAULT_MODEL=luna
KEYBROKER_ALLOWED_MODELS=["luna"]
KEYBROKER_SESSION_MAX_BUDGET_USD=25
# Zero-cost requests are allowed only for explicit local/on-prem model APIs.
KEYBROKER_ALLOW_UNPRICED_LOCAL_MODEL_BASES=["http://llama:8080/v1"]
KEYBROKER_SESSION_TTL_SECONDS=3600
KEYBROKER_REAPER_INTERVAL_SECONDS=60
KEYBROKER_ADMIN_MAX_BUDGET_USD=25000
KEYBROKER_MODEL_BASE_URL=https://infra-lab-services.tail494f6d.ts.net/litellm/v1
