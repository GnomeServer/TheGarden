#!/usr/bin/env python3
"""Become helper. sudo-rs wraps Ansible's -p prompt, so print that prompt first."""

import os
import sys

SUDO = "/usr/bin/sudo"


def main() -> None:
    args = sys.argv[1:]
    prompt = None
    cleaned: list[str] = []
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "-p" and index + 1 < len(args):
            prompt = args[index + 1].strip('"')
            index += 2
            continue
        if arg in {"-n", "--non-interactive"}:
            index += 1
            continue
        cleaned.append(arg)
        index += 1
    if prompt:
        sys.stderr.write(prompt + "\n")
        sys.stderr.flush()
    os.execv(SUDO, [SUDO, *cleaned])


if __name__ == "__main__":
    main()
