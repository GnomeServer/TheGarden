#!/bin/sh
set -eu
if command -v sg >/dev/null 2>&1 && getent group docker >/dev/null 2>&1; then
  case " $(id -nG) " in
    *" docker "*) ;;
    *) exec sg docker -c "exec \"$0\"" ;;
  esac
fi
cd "$HOME/agent-worker"
exec 9>"$HOME/agent-worker/worker.lock"
flock -n 9 || exit 0
set -a
. ./worker.env
set +a
if [ -f "$HOME/.config/litellm/worker-api-key" ]; then
  MODEL_API_KEY=$(tr -d '\r\n' < "$HOME/.config/litellm/worker-api-key")
  export MODEL_API_KEY
fi
while true; do
  "$HOME/agent-worker/.venv/bin/python" -u "$HOME/agent-worker/worker.py" || true
  sleep 5
done
