[Unit]
Description=Dark Factory remote agent worker ({{ worker_id }})
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
Type=simple
User={{ ansible_user_id }}
WorkingDirectory={{ ansible_user_dir }}/agent-worker
ExecStart={{ ansible_user_dir }}/agent-worker/start-worker.sh
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ ansible_user_dir }}/agent-worker {{ ansible_user_dir }}/agent-workspace
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET
# The worker and its children can reach only the service VM; DNS resolvers are not allowed.
IPAddressDeny=any
IPAddressAllow={{ worker_control_plane_ip }}/32

[Install]
WantedBy=multi-user.target
