[Unit]
Description=Garage distributed S3-compatible object store
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User={{ garage_service_user }}
Group={{ garage_service_group }}
ExecStart={{ garage_binary_path }} -c {{ garage_config_path }} server
Environment=RUST_LOG=garage=info
Environment=RUST_BACKTRACE=1
Restart=on-failure
RestartSec=5
LimitNOFILE=42000
UMask=0077

# Garage only needs its configured data and metadata directories writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths={{ garage_meta_dir }} {{ garage_data_dir }}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
