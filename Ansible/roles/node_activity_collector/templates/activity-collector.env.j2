ACTIVITY_MANAGER_URL={{ activity_manager_url }}
ACTIVITY_NODE_ID={{ activity_node_id | default(worker_id | default(inventory_hostname)) }}
ACTIVITY_NODE_KEY_FILE=/etc/dark-factory/activity-key
ACTIVITY_CURSOR_FILE=/var/lib/dark-factory-activity/journal.cursor
ACTIVITY_BATCH_SIZE={{ activity_batch_size | default(25) }}
ACTIVITY_FLUSH_SECONDS={{ activity_flush_seconds | default(5) }}
{% if activity_ca_source is defined and activity_ca_source | length > 0 %}SSL_CERT_FILE=/etc/dark-factory/caddy-root.crt
{% endif %}