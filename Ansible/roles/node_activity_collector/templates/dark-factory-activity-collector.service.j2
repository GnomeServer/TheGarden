[Unit]
Description=Dark Factory node activity collector
After=network-online.target systemd-journald.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/dark-factory/activity-collector.env
ExecStart=/usr/bin/python3 /opt/dark-factory/activity-collector/collector.py
Restart=on-failure
RestartSec=5
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/dark-factory-activity

[Install]
WantedBy=multi-user.target
