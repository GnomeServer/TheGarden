metadata_dir = "{{ garage_meta_dir }}"
data_dir = "{{ garage_data_dir }}"

db_engine = "sqlite"

replication_factor = {{ garage_replication_factor }}

rpc_bind_addr = "[::]:{{ garage_rpc_port }}"
rpc_public_addr = "{{ host_tailscale_address }}:{{ garage_rpc_port }}"
rpc_secret = "{{ garage_rpc_secret }}"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:{{ garage_s3_port }}"

[admin]
api_bind_addr = "[::]:{{ garage_admin_port }}"
